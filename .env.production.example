# Public address including the nginx path prefix.
PUBLIC_BASE_URL=https://111.91.17.185.sslip.io/crackedwall
HOST=0.0.0.0
PORT=5000
MODEL_PATH=best.pt
CONFIDENCE=0.45
MAX_FRAME_EDGE=960
SAVE_INTERVAL_SECONDS=5
VIDEO_PATH=
SOURCE_TYPE=

# Login: set ADMIN_PASSWORD yourself, or use a generated ADMIN_PASSWORD_HASH.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Huawei DDS MongoDB-compatible connection string. Keep empty only during local testing.
MONGO_URI=
DB_NAME=drone_crack
COLLECTION_NAME=detections

# Limit uploads and conserve the 2-vCPU ECS. The video worker samples at 1 FPS.
UPLOAD_MAX_MIB=500
UPLOAD_PROCESS_FPS=1
APP_DEBUG=false
