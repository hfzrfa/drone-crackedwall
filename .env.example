# Copy this file to .env, then change values for your machine.
HOST=0.0.0.0
PORT=5000
MODEL_PATH=best.pt

# VIDEO_PATH has priority over CAMERA_INDEX. Leave it empty for webcam/OBS.
VIDEO_PATH=
VIDEO_LOOP=true
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=20
MAX_FRAME_EDGE=1280
CONFIDENCE=0.45
SAVE_INTERVAL_SECONDS=5

# Optional: video_file, webcam, obs_virtual_camera, or drone_camera.
# When empty, the server infers video_file/webcam from VIDEO_PATH.
SOURCE_TYPE=

# Optional fixed URL used in saved evidence image links.
# Example: http://192.168.1.10:5000
PUBLIC_BASE_URL=

# Leave empty to use the in-memory fallback. Never commit credentials.
MONGO_URI=
DB_NAME=seismic
COLLECTION_NAME=testing
APP_DEBUG=false
